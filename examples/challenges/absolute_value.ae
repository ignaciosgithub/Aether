// Challenge: Absolute Value
// Return the absolute value of a number

func abs_val(n: i64) -> i64 {
    return if (n < 0) { 0 - n } else { n };
}

pub func main() -> i32 {
    println("abs(-42) = 42:");
    println(abs_val(-42));
    println("abs(17) = 17:");
    println(abs_val(17));
    println("abs(0) = 0:");
    println(abs_val(0));
    return 0;
}
