// Challenge: Greatest Common Divisor (GCD)
// Euclidean algorithm: gcd(a, 0) = a, gcd(a, b) = gcd(b, a mod b)

func gcd(a: i64, b: i64) -> i64 {
    return if (b == 0) { a } else { gcd(b, a - (a / b) * b) };
}

pub func main() -> i32 {
    println("gcd(48, 18) = 6:");
    println(gcd(48, 18));
    println("gcd(100, 35) = 5:");
    println(gcd(100, 35));
    println("gcd(17, 13) = 1:");
    println(gcd(17, 13));
    return 0;
}
