// Challenge: Find minimum and maximum of two numbers

func min2(a: i64, b: i64) -> i64 {
    return if (a < b) { a } else { b };
}

func max2(a: i64, b: i64) -> i64 {
    return if (a > b) { a } else { b };
}

pub func main() -> i32 {
    println("min(10, 25) = 10:");
    println(min2(10, 25));
    println("max(10, 25) = 25:");
    println(max2(10, 25));
    println("min(5, 3) = 3:");
    println(min2(5, 3));
    println("max(5, 3) = 5:");
    println(max2(5, 3));
    return 0;
}
