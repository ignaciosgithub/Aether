// Challenge: Power function
// Calculate base^exp by repeated multiplication

func power(base: i64, exp: i64) -> i64 {
    let result: i64 = 1;
    let i: i64 = 0;
    while (i < exp) {
        result = result * base;
        i = i + 1;
    }
    return result;
}

pub func main() -> i32 {
    println("power(2, 10) = 1024:");
    println(power(2, 10));
    println("power(3, 4) = 81:");
    println(power(3, 4));
    return 0;
}
